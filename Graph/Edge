using System;
namespace SmartMap.Graph;
public class Edge
{
    private int to;
    private double distance;

    public Edge(int to, double distance)
    {
        this.to = to;
        this.distance = distance;
    }

    public int GetTo()
    {
        return to;
    }

    public double GetDistance()
    {
        return distance;
    }
}